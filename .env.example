ENV=prod
SITE_ADDRESS=
COMPOSE_PROFILES=none
LOCALE=en # en, fr
POSTGRES_USER=To set
POSTGRES_PASSWORD=To set
POSTGRES_DB=To set
POSTGRES_EXTERNAL_PORT=5432
DB_ROLE_PREFIX=canopy_user_
# Registration
ALLOW_SELF_REGISTRATION=False
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ACTIVATE_GOOGLE_AUTH=False
GOOGLE_CLIENT_ID=To set for Google Auth
GOOGLE_CLIENT_SECRET=To set for Google Auth
# Email / SMTP (defaults for local dev with Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@canopy.dev
SMTP_USE_TLS=False
SMTP_STARTTLS=False
# Geo file import limits (read by the frontend build and by the API)
VITE_GEO_IMPORT_MAX_FILE_SIZE_MB=2048
VITE_GEO_IMPORT_ZIP_MAX_ENTRIES=1000
VITE_GEO_IMPORT_ZIP_MAX_COMPRESSION_RATIO=200
VITE_GEO_IMPORT_ZIP_MAX_UNCOMPRESSED_MB=8192
# Geo file import processing (API only)
GEO_IMPORT_MAX_CONCURRENT=2
GEO_IMPORT_TIMEOUT_S=3600
